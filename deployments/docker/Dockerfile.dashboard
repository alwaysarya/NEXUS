FROM node:20-alpine AS builder
WORKDIR /app
COPY web/apps/dashboard/package*.json ./
RUN npm config set registry https://registry.npmjs.org/ && npm install --no-package-lock
COPY web/apps/dashboard/ .
RUN npx vite build

FROM nginx:alpine
COPY web/apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
