@import "tailwindcss";

:root{font-family:"DM Sans",sans-serif;color:#e9edf6;background:#080b11;font-synthesis:none;text-rendering:optimizeLegibility;font-optical-sizing:auto;font-weight:400}
*{box-sizing:border-box}
body{margin:0;min-width:360px;min-height:100vh;background:#080b11}
button,input{font:inherit}
button{cursor:pointer}
.app-shell{min-height:100vh;background:radial-gradient(ellipse at 70% -20%,#17234455,transparent 48%),#080b11}
.sidebar{width:248px;position:fixed;inset:0 auto 0 0;background:#0c1018;border-right:1px solid #ffffff0c;padding:25px 16px 15px;display:flex;flex-direction:column;z-index:20}
.brand{height:38px;display:flex;align-items:center;gap:10px;padding:0 9px;font:800 17px Manrope;letter-spacing:2.7px;color:#f5f7ff}
.brand-mark{width:23px;height:23px;border:1px solid #7292ff;border-radius:7px;display:grid;place-items:center;transform:rotate(-10deg);box-shadow:0 0 20px #6388ff30}
.brand-mark span{width:9px;height:9px;border:2px solid #91aaff;border-radius:2px;transform:rotate(45deg)}
.brand-version{font:600 9px "DM Sans";letter-spacing:1.4px;color:#66748c;margin-left:-5px}
.workspace-switch{margin:30px 0 30px;padding:12px;background:#ffffff07;border:1px solid #ffffff0c;border-radius:11px;display:flex;align-items:center;gap:10px}
.workspace-avatar,.profile-avatar,.top-avatar{width:32px;height:32px;border-radius:9px;background:linear-gradient(145deg,#7895ff,#4557ae);display:grid;place-items:center;font-weight:700;color:white}
.workspace-text,.profile-info{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1}
.workspace-text strong,.profile-info strong{font-size:11px;font-weight:600;color:#dce3f1}
.workspace-text span,.profile-info span{font-size:10px;color:#707e94}
.muted{color:#647188}
.nav-caption,.mini-label{font-size:9px;font-weight:700;letter-spacing:1.55px;color:#697790}
.nav-caption{padding:0 11px 10px}
.navigation{display:grid;gap:4px}
.nav-item{height:39px;border:0;background:transparent;color:#8490a4;display:flex;align-items:center;gap:12px;padding:0 11px;border-radius:8px;text-align:left;font-size:12px;transition:.2s}
.nav-item:hover{background:#ffffff09;color:#e3eaff}
.nav-item.active{background:linear-gradient(90deg,#5576e51e,#5576e50a);color:#9db2ff;box-shadow:inset 2px 0 #7895ff}
.nav-count{margin-left:auto;font-size:10px;color:#8799c2;background:#718fff18;padding:3px 7px;border-radius:5px}
.nav-caption-bottom{margin-top:31px}
.sidebar-bottom{margin-top:auto}
.help-card{padding:14px;background:linear-gradient(145deg,#151e31,#111725);border:1px solid #ffffff10;border-radius:11px;margin-bottom:18px}
.help-icon{width:28px;height:28px;display:grid;place-items:center;color:#9bb1ff;background:#7895ff18;border-radius:8px;margin-bottom:10px}
.help-card strong{font-size:11px}.help-card p{font-size:10px;line-height:1.6;color:#8290a6;margin:6px 0 12px}
.help-card button,.text-button{border:0;background:transparent;color:#9bb0ff;font-size:10px;display:flex;align-items:center;gap:5px;padding:0}
.profile{border-top:1px solid #ffffff0d;padding:16px 5px 0;display:flex;align-items:center;gap:10px}
.profile-avatar,.top-avatar{border-radius:50%;width:30px;height:30px;font-size:12px}
.main-area{margin-left:248px;min-height:100vh}
.topbar{height:67px;border-bottom:1px solid #ffffff0c;display:flex;align-items:center;justify-content:space-between;padding:0 38px;background:#0b0f17bb;backdrop-filter:blur(20px);position:sticky;top:0;z-index:10}
.breadcrumbs,.top-actions{display:flex;align-items:center;gap:12px;color:#65738a;font-size:11px}
.breadcrumbs strong{color:#dbe3f3;font-weight:500}
.top-actions{gap:17px}.environment{display:flex;align-items:center;gap:8px;color:#c3cde0;background:#ffffff07;padding:8px 11px;border:1px solid #ffffff0d;border-radius:7px;font-size:10px}
.environment-dot,.pulse-dot{width:6px;height:6px;border-radius:50%;background:#55d5a1;box-shadow:0 0 9px #55d5a188}
.top-divider{height:22px;width:1px;background:#ffffff15}
.icon-button,.small-icon{border:0;background:transparent;color:#8c9ab0;display:grid;place-items:center;padding:5px;position:relative}
.icon-button:hover,.small-icon:hover{color:white}.notification i{position:absolute;width:5px;height:5px;background:#f18c76;border-radius:50%;right:3px;top:2px}
.top-avatar{width:29px;height:29px}
.page-content{max-width:1600px;margin:auto;padding:35px 38px 22px}
.page-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:27px;gap:20px}
.eyebrow{font-size:9px;letter-spacing:1.7px;color:#8291aa;font-weight:700;display:flex;align-items:center;gap:9px}
.eyebrow-line{width:18px;height:1px;background:#7694ff}.eyebrow-dot{color:#45536a}
h1,h2,h3,p{margin-top:0}
h1{font:700 clamp(27px,3vw,36px) Manrope;letter-spacing:-1.6px;margin:12px 0 6px;color:#f0f3fa}
h1 span{color:#8294b6}
.page-subtitle{font-size:12px;color:#7e8ba1;margin:0}
.heading-actions{display:flex;align-items:center;gap:14px}
.connection-pill{font-size:10px;color:#e8a18f;display:flex;align-items:center;gap:8px}
.connection-pill .pulse-dot{background:#e59a81;box-shadow:none}
.connection-pill.is-connected{color:#73d9ad}.connection-pill.is-connected .pulse-dot{background:#55d5a1;box-shadow:0 0 9px #55d5a188}
.primary-button{display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#7593ff,#5272e4);color:white;border:1px solid #91a7ff55;border-radius:8px;padding:10px 15px;font-size:11px;font-weight:600;box-shadow:0 5px 20px #5272e42b;transition:.2s}
.primary-button:hover{transform:translateY(-1px);box-shadow:0 8px 25px #5272e450}.primary-button:disabled{opacity:.5;cursor:wait}
.notice{padding:11px 14px;border:1px solid #4d9b7955;background:#163326;color:#a7e6c5;border-radius:8px;font-size:11px;display:flex;align-items:center;gap:9px;margin-bottom:18px}.notice button{margin-left:auto;background:none;border:0;color:inherit}
.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:32px}
.metric-card{position:relative;overflow:hidden;background:linear-gradient(145deg,#141b28,#101620);border:1px solid #ffffff10;border-radius:11px;padding:17px 17px 15px;min-height:145px;transition:border-color .2s}
.metric-card:hover{border-color:#839aff44}
.metric-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}
.metric-icon{width:30px;height:30px;border-radius:8px;display:grid;place-items:center}.metric-icon svg{width:15px;height:15px}
.blue{color:#88a4ff;background:#7190ff19}.violet{color:#b5a0ff;background:#9d7dff19}.cyan{color:#70d9e7;background:#52d2e719}.amber{color:#e8bd7c;background:#e6b66b19}
.metric-trend{font-size:9px;color:#65748c}.metric-label{font-size:10px;color:#8996aa}.metric-value{font:700 25px Manrope;letter-spacing:-1px;color:#edf1fb;margin:5px 0}.metric-detail{font-size:10px;color:#748198}
.metric-accent{position:absolute;bottom:0;left:0;height:2px;width:100%;opacity:.55}.metric-accent.blue{background:#7995ff}.metric-accent.violet{background:#aa91ff}.metric-accent.cyan{background:#62d5e5}.metric-accent.amber{background:#e4b56d}
.section-heading{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:12px}
.section-heading h2{font:650 15px Manrope;letter-spacing:-.3px;margin:0 0 4px}.section-heading p{font-size:10px;color:#77859b;margin:0}
.topology-tools{display:flex;align-items:center;gap:14px}.legend{display:flex;align-items:center;gap:6px;color:#8290a4;font-size:9px}.legend i,.topology-footer i{width:6px;height:6px;border-radius:50%}.legend-online{background:#55d5a1;box-shadow:0 0 8px #55d5a177}.legend-offline{background:#586477}
.topology-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(245px,.8fr);gap:13px;margin-bottom:14px}
.topology-card,.health-card,.panel{background:linear-gradient(145deg,#121a27,#0f151f);border:1px solid #ffffff10;border-radius:11px;overflow:hidden}
.topology-card-head,.health-head{padding:15px 17px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff0b}
.topology-card-head>div,.health-head>div{display:grid;gap:5px}.topology-card-head strong,.health-head strong{font:600 12px Manrope;color:#dfe6f4}
.live-tag{font-size:8px;letter-spacing:1px;color:#66d8a8;background:#54d59e13;border:1px solid #54d59e25;padding:5px 8px;border-radius:5px;display:flex;align-items:center;gap:6px}.live-tag i{width:5px;height:5px;border-radius:50%;background:#55d5a1}
.topology-canvas{height:294px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 49%,#354c7d25,transparent 40%),#0c121c}
.topo-grid{position:absolute;inset:0;background-image:linear-gradient(#7185b00a 1px,transparent 1px),linear-gradient(90deg,#7185b00a 1px,transparent 1px);background-size:28px 28px;mask-image:linear-gradient(transparent,#000 15%,#000 85%,transparent)}
.topo-lines{position:absolute;inset:0;width:100%;height:100%}.flow-line{animation:dash 8s linear infinite}@keyframes dash{to{stroke-dashoffset:-100}}
.cloud-core{position:absolute;left:50%;top:49%;transform:translate(-50%,-50%);width:140px;height:140px;border:1px solid #7895ff65;border-radius:50%;background:radial-gradient(circle,#263c6d88,#111b31ee 68%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;z-index:2}
.cloud-core:before,.cloud-core:after{content:"";position:absolute;inset:-9px;border:1px solid #7895ff25;border-radius:50%;animation:orbit 8s linear infinite}.cloud-core:after{inset:-19px;border-color:#7895ff13;animation-direction:reverse;animation-duration:13s}@keyframes orbit{to{transform:rotate(360deg)}}
.core-icon{color:#9db2ff;margin-bottom:2px}.cloud-core strong{font:700 10px Manrope;letter-spacing:1.4px}.cloud-core>span{font-size:7px;letter-spacing:1.5px;color:#8293b6}.core-status{font-size:7px;color:#6bd8aa;letter-spacing:1px;display:flex;align-items:center;gap:5px;margin-top:4px}.core-status i{width:5px;height:5px;border-radius:50%;background:#55d5a1}
.topo-node{position:absolute;z-index:3;transform:translate(-50%,-50%);background:#151f2e;border:1px solid #ffffff18;border-radius:8px;padding:7px 9px;min-width:112px;text-align:left;display:grid;grid-template-columns:21px 1fr;column-gap:6px;align-items:center;box-shadow:0 8px 22px #0005;transition:border-color .2s}
.topo-node:hover{border-color:#7895ff88}.node-icon{grid-row:span 2;color:#8da6ff;position:relative}.node-icon i{position:absolute;width:5px;height:5px;background:#55d5a1;border-radius:50%;right:-1px;top:0}.node-offline .node-icon{color:#778194}.node-offline .node-icon i{background:#687386}
.topo-node strong{font-size:8px;color:#d8e0ef;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100px}.topo-node>span{font-size:7px;color:#6d7e96;text-transform:uppercase;letter-spacing:.6px}
.topology-coordinate{position:absolute;bottom:10px;left:14px;color:#4f6078;font-size:7px;letter-spacing:1.3px}
.topology-zoom{position:absolute;right:12px;bottom:10px;display:flex;gap:4px}.topology-zoom button{width:22px;height:22px;background:#182235;border:1px solid #ffffff13;border-radius:5px;color:#93a5c5}
.topology-footer{height:34px;padding:0 15px;display:flex;align-items:center;gap:17px;border-top:1px solid #ffffff0a;color:#8794a8;font-size:8px}.topology-footer span{display:flex;align-items:center;gap:6px}.topology-updated{margin-left:auto;color:#586982}
.health-card{padding-bottom:12px}.health-head{border:0}.health-head>svg{color:#70d6a8}
.health-score{display:grid;place-items:center;padding:12px 0 17px}
.health-ring{width:118px;height:118px;border-radius:50%;background:conic-gradient(#5bdda5 var(--score),#ffffff0b 0);display:grid;place-items:center;position:relative}
.health-ring:before{content:"";position:absolute;inset:7px;border-radius:50%;background:#121a27}
.health-ring>div{z-index:1;text-align:center;display:grid;gap:2px}.health-ring strong{font:750 29px Manrope;color:#edf6f2}.health-ring small{font-size:12px;color:#6bd5a5}.health-ring span{font-size:8px;letter-spacing:1.6px;color:#74859a}
.health-list{padding:0 16px;display:grid;gap:13px}.health-row{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:9px;color:#8491a5}.health-row strong{display:flex;align-items:center;gap:6px;font-size:9px;color:#c4cfdf;font-weight:500;text-align:right}.health-row i{width:5px;height:5px;border-radius:50%}.dot-ok{background:#55d5a1;box-shadow:0 0 7px #55d5a166}.dot-bad{background:#e58e83}
.health-foot{margin:17px 13px 0;padding:9px;background:#7895ff0c;border:1px solid #7895ff17;border-radius:7px;display:flex;align-items:center;gap:8px;color:#8c9cba;font-size:8px;line-height:1.5}.health-foot-icon{color:#9bb0ff}
.lower-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:13px}
.panel{padding:16px}
.panel-heading{display:flex;align-items:center;justify-content:space-between}.panel-heading h3{font:650 13px Manrope;margin:5px 0 0}.period-button{display:flex;align-items:center;gap:7px;padding:6px 9px;border-radius:6px;background:#ffffff07;border:1px solid #ffffff10;color:#9ca9bc;font-size:9px}
.chart-legend{display:flex;gap:16px;margin:18px 0 0 3px;font-size:8px;color:#8290a4}.chart-legend span{display:flex;align-items:center;gap:6px}.chart-legend i{width:7px;height:7px;border-radius:2px}.chart-blue{background:#6d8bff}.chart-violet{background:#aa91ff}
.resource-chart{height:146px;margin-top:8px}.resource-totals{display:flex;gap:40px;border-top:1px solid #ffffff0c;padding-top:12px}.resource-totals div{display:grid;gap:5px}.resource-totals span{font-size:8px;color:#77869c}.resource-totals strong{font:600 10px Manrope;color:#cbd5e5}
.chart-disclaimer{font-size:8px;color:#56657b;margin:12px 0 0}
.text-button{font-size:9px}.workload-list{margin-top:13px;min-height:150px}
.workload-row{display:flex;align-items:center;gap:9px;padding:10px 0;border-bottom:1px solid #ffffff0a}.workload-icon{width:28px;height:28px;border-radius:7px;display:grid;place-items:center;background:#7895ff13;color:#91a8ff}.workload-details{display:grid;gap:4px;flex:1;min-width:0}.workload-details strong{font-size:9px;color:#cbd6e8;overflow:hidden;text-overflow:ellipsis}.workload-details span{font-size:8px;color:#718097}
.status-label{font-size:8px;padding:4px 7px;border-radius:5px;text-transform:capitalize}.status-running{background:#53d39c14;color:#65d6a6}.status-done{background:#ffffff09;color:#8592a7}
.complete-button{border:0;background:transparent;color:#75d8aa;padding:4px}.deploy-secondary{margin-top:11px;width:100%;display:flex;align-items:center;justify-content:center;gap:7px;background:#7895ff0d;border:1px dashed #7895ff40;color:#9bb0ff;border-radius:7px;padding:9px;font-size:9px}
.empty-state{display:grid;justify-items:center;gap:8px;padding:25px 5px;color:#65748c}.empty-state strong{font-size:10px;color:#c0cce0}.empty-state span{font-size:9px}
.footer{display:flex;justify-content:space-between;padding:20px 2px 0;margin-top:5px;color:#4e5c71;font-size:7px;letter-spacing:1px}.footer span{display:flex;align-items:center;gap:6px}.footer span:nth-child(2){color:#66cfa2}.footer i{width:5px;height:5px;border-radius:50%;background:#55d5a1}
.modal-backdrop{position:fixed;inset:0;background:#03060bd9;backdrop-filter:blur(9px);z-index:50;display:grid;place-items:center;padding:20px}
.modal-card{width:min(440px,100%);background:#141c2a;border:1px solid #ffffff1b;border-radius:14px;padding:22px;box-shadow:0 25px 80px #0009;display:grid;gap:17px}
.modal-heading{display:flex;align-items:center;justify-content:space-between}.modal-heading h3{font:700 19px Manrope;margin:5px 0 0}.modal-description{font-size:11px;color:#8997ad;margin:-8px 0 0}
.create-modal label{display:grid;gap:7px;font-size:10px;color:#aab6ca}.create-modal input{width:100%;background:#0d1420;border:1px solid #ffffff18;border-radius:7px;padding:11px;color:#e8edf8;outline:none;font-size:11px}.create-modal input:focus{border-color:#7895ff88;box-shadow:0 0 0 3px #7895ff16}.form-split{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-submit{width:100%;margin-top:3px}
.mobile-close,.menu-button{display:none}.mobile-backdrop{display:none}
@media(max-width:1100px){.sidebar{width:220px}.main-area{margin-left:220px}.page-content{padding:28px 23px}.topbar{padding:0 24px}.topology-layout{grid-template-columns:minmax(0,1.5fr) minmax(220px,.8fr)}.metric-grid{gap:9px}.metric-card{padding:14px}.metric-trend{font-size:8px}}
@media(max-width:820px){.sidebar{transform:translateX(-100%);transition:transform .25s;width:260px}.sidebar-open{transform:translateX(0)}.mobile-backdrop{display:block;position:fixed;inset:0;background:#0009;z-index:19}.mobile-close,.menu-button{display:grid;place-items:center;background:transparent;border:0;color:#9eacc3}.mobile-close{margin-left:auto}.main-area{margin-left:0}.topbar{padding:0 20px}.menu-button{padding:4px}.page-content{padding:25px 20px}.metric-grid{grid-template-columns:repeat(2,1fr)}.topology-layout{grid-template-columns:1fr}.health-card{display:grid;grid-template-columns:1fr 1fr;align-items:center}.health-head{grid-column:1/-1}.health-score{grid-row:span 2}.health-list{padding:10px}.health-foot{margin:10px}.lower-grid{grid-template-columns:1fr}}
@media(max-width:540px){.topbar{height:58px;padding:0 14px}.breadcrumbs{gap:7px}.environment{display:none}.top-actions{gap:10px}.page-content{padding:22px 14px}.page-heading{display:grid;align-items:start}.heading-actions{justify-content:space-between;flex-wrap:wrap}.connection-pill{font-size:9px}.metric-grid{gap:8px}.metric-card{min-height:132px;padding:12px}.metric-value{font-size:22px}.metric-trend{font-size:7px}.topology-canvas{height:265px}.topo-node{min-width:90px;padding:6px}.topo-node strong{max-width:78px;font-size:7px}.cloud-core{width:112px;height:112px}.core-icon svg{width:23px}.topology-footer{gap:9px;font-size:7px}.topology-updated{display:none}.health-card{grid-template-columns:1fr}.health-score{grid-row:auto}.health-list{padding:0 16px}.health-foot{margin:15px 13px 0}.resource-totals{gap:17px}.resource-totals strong{font-size:9px}.footer{gap:8px;font-size:6px;flex-wrap:wrap}.footer span:last-child{display:none}}

/* NEXUS global layout and responsive safety */
*, *::before, *::after {
  box-sizing: border-box;
}
html, body, #root {
  width: 100%;
  min-height: 100%;
  margin: 0;
}
html {
  overflow-x: clip;
  scroll-behavior: smooth;
}
body {
  max-width: 100%;
  overflow-x: hidden;
}
.app-shell, .main-area, .page-content {
  min-width: 0;
  max-width: 100%;
}
img, svg, video, canvas {
  max-width: 100%;
}
button, input {
  min-width: 0;
}
button:focus-visible, input:focus-visible {
  outline: 2px solid #7895ff;
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Live allocation meters and feedback states */
.allocation-meters {
  display: grid;
  gap: 28px;
  min-height: 190px;
  align-content: center;
  padding: 20px 2px;
}
.allocation-meter {
  display: grid;
  gap: 10px;
}
.allocation-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: #aab6ca;
  font-size: 11px;
}
.allocation-label span {
  display: flex;
  align-items: center;
  gap: 8px;
}
.allocation-label strong {
  color: #e3eafa;
  font-variant-numeric: tabular-nums;
}
.allocation-meter small {
  color: #718097;
  font-size: 10px;
}
.allocation-track {
  height: 8px;
  background: #ffffff0d;
  border-radius: 99px;
  overflow: hidden;
}
.allocation-fill {
  display: block;
  height: 100%;
  border-radius: inherit;
  transition: width .35s ease;
}
.cpu-fill { background: #6d8bff; }
.ram-fill { background: #aa91ff; }
.notice-error {
  border-color: #e2767655;
  background: #3b1c24;
  color: #ffc0c0;
}
.notice-info {
  border-color: #7895ff44;
  background: #17243b;
  color: #c0d0ff;
}
.notice-success {
  border-color: #4d9b7955;
  background: #163326;
  color: #a7e6c5;
}
